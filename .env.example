# Copy to .env and fill in real values. Never commit .env.

# Admin password for the site's login modal and season reset.
ADMIN_PASSWORD=

# start.gg API token: https://start.gg/admin/profile/developer
STARTGG_TOKEN=

# Postgres
DB_PASSWORD=
DB_NAME=irishtts
DB_USER=postgres
DB_HOST=localhost
DB_PORT=5432

# Comma-separated list of allowed CORS origins, or * for any.
# The frontend calls /api on the same origin, so a specific origin is safe.
ALLOWED_ORIGINS=*
